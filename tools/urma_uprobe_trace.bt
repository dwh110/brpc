#!/usr/bin/env bpftrace
/*
 * urma_uprobe_trace.bt — non-intrusive uprobe tracing of every URMA API that
 * brpc actually uses, for brpc/URMA performance analysis (incl. warm-up
 * attribution).
 *
 * This file is a TEMPLATE processed by urma_uprobe_trace.sh. Do not run
 * bpftrace on it directly unless you have already substituted:
 *   @__LIBURMA__@  -> path/name of liburma.so (e.g. liburma.so)
 *
 * PID filtering is done by bpftrace's native -p PID flag (no template var).
 *
 * Behaviour:
 *   - Control-plane APIs (init/create/import/advise/register/...): every call
 *     is logged with comm/tid/latency. This is the warm-up path and the most
 *     direct way to attribute the first-RPC ~50ms cost.
 *   - Data-plane APIs (post_jetty_send_wr, poll_jfc, rearm_jfc, wait_jfc, ack_jfc):
 *     per-function latency histogram + count + sum + max. Slow calls (>1ms)
 *     are still logged individually.
 *   - Every 5s: top callers by count.
 *   - On Ctrl-C: full histogram dump and final ranking.
 *
 * Requires: bpftrace >= v0.11, liburma.so with symbols (not stripped),
 *           CONFIG_UPROBES in kernel, root (CAP_BPF/CAP_SYS_ADMIN).
 */

BEGIN
{
    printf("urma uprobe tracer attached. lib=@__LIBURMA__@ sample_rate=1/@__SAMPLE_RATE__@\n");
    printf("Control-plane always traced (warm-up path).\n");
    printf("Data-plane sampled at 1/@__SAMPLE_RATE__@. Ctrl-C for final stats.\n\n");
}

/* ========================================================================
 * Helper macro (inline via probe name): on entry record timestamp + count.
 * Per-function map keyed by function name -> nesting of DIFFERENT urma calls
 * is fine; same-function re-entrancy would clobber (does not happen in liburma).
 * ====================================================================== */

/* ---- Control-plane: warm-up / per-connection ---- */

uprobe:@__LIBURMA__@:urma_init
{ @e[tid, 101] = nsecs; @cnt["urma_init"] = count(); }
uretprobe:@__LIBURMA__@:urma_init
/ @e[tid, 101] /
{
    $d = nsecs - @e[tid, 101];
    @lat["urma_init"] = lhist($d / 1000, 0, 1000, 1);
    @sum["urma_init"] = sum($d);
    @max["urma_init"] = max($d);
    if ($d > 1000000) {
        @slow["urma_init"] = count();
        printf("[SLOW] urma_init pid=%lu tid=%lu lat=%llu us\n", pid, tid, $d/1000);
    }
    delete(@e[tid, 101]);
}

