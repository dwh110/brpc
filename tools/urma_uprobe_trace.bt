/* ========================================================================
 * Data-plane: per-RPC hot path.
 *
 * Overhead control (2 layers):
 *   1. Sampling: only 1/SAMPLE_RATE entries record a timestamp. The return
 *      probe checks for the entry map key; if absent (99% of calls), it does
 *      nothing. This bounds per-hit work to the trap + predicate cost.
 *   2. Integer @e keys (1..7): integer-keyed map lookups are ~5x faster than
 *      string-keyed. Output maps (@cnt/@lat/@sum/@max) keep string keys for
 *      readability since they are only updated on the sampled return path.
 *
 * Integer key legend:
 *   1=urma_post_jetty_send_wr  2=urma_post_jetty_recv_wr  3=urma_post_jfr_wr
 *   4=urma_poll_jfc            5=urma_rearm_jfc           6=urma_wait_jfc
 *   7=urma_ack_jfc
 *
 * NOTE: uprobe trap cost (~200-500ns/hit on modern kernels) is paid on EVERY
 * call regardless of sampling — it is the kernel breakpoint cost. For TRUE
 * zero overhead when not capturing, kill bpftrace and restart only for short
 * capture windows.
 * ====================================================================== */

uprobe:@__LIBURMA__@:urma_post_jetty_send_wr
{
    @cnt["urma_post_jetty_send_wr"] = count();
    if ((nsecs % @__SAMPLE_RATE__@) == 0) { @e[tid, 1] = nsecs; }
}
uretprobe:@__LIBURMA__@:urma_post_jetty_send_wr
/ @e[tid, 1] /
{
    $d = nsecs - @e[tid, 1];
    @lat["urma_post_jetty_send_wr"] = lhist($d / 1000, 0, 1000, 1);
    @sum["urma_post_jetty_send_wr"] = sum($d);
    @max["urma_post_jetty_send_wr"] = max($d);
    if ($d > 1000000) {
        @slow["urma_post_jetty_send_wr"] = count();
        printf("[SLOW] urma_post_jetty_send_wr pid=%lu tid=%lu lat=%llu us\n", pid, tid, $d/1000);
    }
    delete(@e[tid, 1]);
}

uprobe:@__LIBURMA__@:urma_post_jetty_recv_wr
{
    @cnt["urma_post_jetty_recv_wr"] = count();
    if ((nsecs % @__SAMPLE_RATE__@) == 0) { @e[tid, 2] = nsecs; }
}
uretprobe:@__LIBURMA__@:urma_post_jetty_recv_wr
/ @e[tid, 2] /
{
