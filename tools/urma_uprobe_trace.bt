}

/* ========================================================================
 * Periodic summary: top callers by count every 5 seconds.
 * ====================================================================== */
interval:s:5
{
    time("[%H:%M:%S] top callers @cnt:\n");
    print(@cnt);
    clear(@cnt);
}

/* ========================================================================
 * Final report on Ctrl-C.
 * ====================================================================== */
END
{
    printf("\n==================== FINAL REPORT ====================\n");

    printf("\n--- Call counts (@cnt) ---\n");
    print(@cnt);

    printf("\n--- Total time spent per function, in ms (@sum / 1e6) ---\n");
    print(@sum);

    printf("\n--- Worst single latency per function, in ms (@max / 1e6) ---\n");
    print(@max);

    printf("\n--- Slow-call (>1ms) counts (@slow) ---\n");
    print(@slow);

    printf("\n--- Latency histograms (us) per function (@lat) ---\n");
    print(@lat);

    printf("=====================================================\n");
}
