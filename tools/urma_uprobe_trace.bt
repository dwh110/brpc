/* ========================================================================
 * Data-plane: per-RPC hot path. Histograms + slow-call logging (>1ms).
 * At ~200k QPS the per-call printf would kill throughput, so we only log
 * outliers. The histogram captures the steady-state latency distribution.
 * ====================================================================== */

uprobe:@__LIBURMA__@:urma_post_jetty_send_wr
{ @e[tid, "urma_post_jetty_send_wr"] = nsecs; @cnt["urma_post_jetty_send_wr"] = count(); }
uretprobe:@__LIBURMA__@:urma_post_jetty_send_wr
/ @e[tid, "urma_post_jetty_send_wr"] /
{
    $d = nsecs - @e[tid, "urma_post_jetty_send_wr"];
    @lat["urma_post_jetty_send_wr"] = hist($d / 1000);
    @sum["urma_post_jetty_send_wr"] = sum($d);
    @max["urma_post_jetty_send_wr"] = max($d);
    if ($d > 1000000) {
        @slow["urma_post_jetty_send_wr"] = count();
        printf("[SLOW] urma_post_jetty_send_wr pid=%d tid=%d lat=%llu us\n", pid, tid, $d/1000);
    }
    delete(@e[tid, "urma_post_jetty_send_wr"]);
}

uprobe:@__LIBURMA__@:urma_post_jetty_recv_wr
{ @e[tid, "urma_post_jetty_recv_wr"] = nsecs; @cnt["urma_post_jetty_recv_wr"] = count(); }
